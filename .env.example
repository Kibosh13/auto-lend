# Canonical production origin used for social sharing metadata
SITE_URL=https://ngreport.ru
FEED_API_URL=http://127.0.0.1:3101/api/posts
ADMIN_API_URL=http://127.0.0.1:3101
ADMIN_INTERNAL_KEY=

# Feed service ONLY. Production values belong in /etc/ngreport.env, mode 600.
# Never put an actual bot token in this template or a Git-tracked file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=ngreport
TELEGRAM_CHANNEL_ID=-1002151655824
DATA_DIR=./data
PUBLIC_ORIGIN=https://ngreport.ru
FEED_PORT=3101
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
